{
  "name": "vscode-sops",
  "displayName": "SOPS Safe",
  "description": "SOPS editing that keeps plaintext out of workspace files agents can ingest, with verified private tmpfs and atomic saves.",
  "version": "0.1.0",
  "publisher": "jgus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgus-org/nix.git",
    "directory": "flakes/vscode-sops"
  },
  "homepage": "https://github.com/jgus-org/nix/tree/main/flakes/vscode-sops",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sops",
    "secrets",
    "encryption",
    "age",
    "gitops",
    "security"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#061b3a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vscode-sops.openDecrypted",
    "onCommand:vscode-sops.encryptInPlace",
    "onCommand:vscode-sops.checkSecurityPosture",
    "onCommand:vscode-sops.resetTrustedExtensions",
    "onFileSystem:sops"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-sops.openDecrypted",
        "title": "SOPS: Open Decrypted"
      },
      {
        "command": "vscode-sops.encryptInPlace",
        "title": "SOPS: Encrypt in Place"
      },
      {
        "command": "vscode-sops.checkSecurityPosture",
        "title": "SOPS: Check Security Posture"
      },
      {
        "command": "vscode-sops.resetTrustedExtensions",
        "title": "SOPS: Reset Trusted Extensions"
      }
    ],
    "configuration": {
      "title": "SOPS Safe",
      "properties": {
        "vscode-sops.sopsPath": {
          "type": "string",
          "default": "sops",
          "description": "SOPS executable used for detection, decryption, and encryption."
        },
        "vscode-sops.runtimeDirectory": {
          "type": "string",
          "default": "",
          "description": "Private extension runtime directory beneath XDG_RUNTIME_DIR. The default is $XDG_RUNTIME_DIR/vscode-sops."
        },
        "vscode-sops.trustedExtensions": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Machine-local non-built-in extension identifiers trusted to share the extension host with decrypted documents."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:test": "tsc --project tsconfig.test.json",
    "check": "tsc --noEmit",
    "package": "npm run build && vsce package --allow-missing-repository --out vscode-sops-${npm_package_version}.vsix",
    "test": "npm run check && npm run build:test && node --test build-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
